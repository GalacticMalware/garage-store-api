# --- Server ---
PORT=3000

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=garage_storage
DB_POOL_LIMIT=10

# --- JWT (mínimo 32 caracteres) ---
JWT_SECRET=
JWT_EXPIRES_IN=5m

# --- Garage / S3 ---
GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_REGION=garage
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=images
PUBLIC_BASE_URL=https://media.example.com/images
MAX_UPLOAD_MB=10
